# Public URL printed by the Kaggle/Colab notebook (the trycloudflare.com link).
# Changes every notebook session: update it in Vercel > Settings > Environment Variables, then redeploy.
NATLAS_BASE_URL=https://your-tunnel.trycloudflare.com

# Optional: only if you set NATLAS_API_KEY as a Kaggle secret (llama-server --api-key).
NATLAS_API_KEY=

# Optional: max requests per IP per minute through the proxy (default 20).
NATLAS_RATE_LIMIT_PER_MIN=20
