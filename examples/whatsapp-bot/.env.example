# Meta for Developers > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Any secret string; paste the same value as "Verify token" in the webhook settings
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
# Optional: App Settings > Basic > App Secret (enables X-Hub-Signature-256 checks)
WHATSAPP_APP_SECRET=

# Your N-ATLaS server (see server/ in the repo root: free Kaggle T4 + Cloudflare tunnel)
NATLAS_BASE_URL=https://your-tunnel.trycloudflare.com
NATLAS_API_KEY=
